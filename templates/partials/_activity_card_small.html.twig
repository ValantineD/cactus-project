<div style="width: 120px; flex-shrink: 0;">
    <a href="{{ path('app_activity_show', {id: activity.id}) }}"
       class="text-decoration-none text-dark d-block"
       style="width: 120px; height: 120px; border-radius: 10px;
              overflow: hidden; position: relative;
              box-shadow: 0 1px 6px rgba(0,0,0,0.12);">
        {% set firstImage = activity.imageFiles.first() %}
        {% if firstImage %}
            {% set splitFilename = asset(firstImage.filename)|split('.') %}
            {% set imagefilename = splitFilename|join('_small.') %}
            <img src="{{ imagefilename }}"
                 alt="{{ activity.title }}"
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy">
        {% else %}
            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25">
                <i class="bi bi-image text-muted" style="font-size: 1.5rem;"></i>
            </div>
        {% endif %}

        {% if activity.imageFiles is not empty %}
            <img src="{{ imagefilename}}"
                 alt="{{ activity.title }}"
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy">
        {% else %}
            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25">
                <i class="bi bi-image text-muted" style="font-size: 1.5rem;"></i>
            </div>
        {% endif %}

        {% if app.user %}
            {% if app.user == activity.user %}
                <span class="position-absolute top-0 end-0 m-1 badge tag-creator" style="font-size: 0.55rem;">
                    Créateur
                </span>
            {% else %}
                {% set isParticipating = false %}
                {% for p in activity.participations %}
                    {% if p.user == app.user %}
                        {% set isParticipating = true %}
                    {% endif %}
                {% endfor %}
                {% if isParticipating %}
                    <span class="position-absolute top-0 end-0 m-1 badge d-flex align-items-center gap-1 tag-participation" style="font-size: 0.55rem;">
                        <i class="bi bi-check-circle-fill"></i>
                        Participation
                    </span>
                {% endif %}
            {% endif %}
        {% endif %}
    </a>

    <div class="mt-1">
        <p class="mb-0 fw-bold" style="font-size: 0.75rem; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ activity.title }}</p>
        <small class="text-muted" style="font-size: 0.7rem;">
            {{ activity.dateStart ? activity.dateStart|date('M d') : '' }}
        </small>
    </div>
</div>
