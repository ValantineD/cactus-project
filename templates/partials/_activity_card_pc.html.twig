<div class="">
    <a href="{{ path('app_activity_show', {id: activity.id}) }}"
       class="text-decoration-none text-dark">
        <div class="h-100" style="border-radius: 8px; overflow: hidden;">

            <div style="height: 200px; overflow: hidden; background: #e9e9e9; position: relative;">
                {% if activity.imageFiles is not empty %}
                    {% set splitFilename = asset(activity.imageFiles[0].filename)|split('.') %}
                    {% set imagefilename = splitFilename|join('_medium.') %}
                    <img src="{{ imagefilename }}"
                         alt="{{ activity.title }}"
                         style="max-width: 500px; object-fit: cover;"
                         loading="lazy" class="w-100 h-100">
                {% else %}
                    <div
                        class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25">
                        <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                    </div>
                {% endif %}
                {% if app.user %}
                    {% if app.user == activity.user %}
                        <span class="position-absolute top-0 end-0 m-2 badge tag-creator">
                            Créateur
                        </span>
                    {% else %}
                        {% set isParticipating = false %}
                        {% for p in activity.participations %}
                            {% if p.user == app.user %}
                                {% set isParticipating = true %}
                            {% endif %}
                        {% endfor %}
                        {% if isParticipating %}
                            <span class="position-absolute top-0 end-0 m-2 badge d-flex align-items-center gap-1
                            tag-participation">
                                <i class="bi bi-check-circle-fill"></i>
                                Participation
                            </span>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>

            <div class="d-flex align-items-center justify-content-between gap-1 p-1">
                {% for theme in activity.themes %}
                    <div
                        class="d-flex badges-theme align-items-center justify-content-center gap-1 p-1 {{ (activity.themes|length  > 1) ? "w-50" : "w-100" }}">
                        <img src="{{ asset(theme.iconFilename) }}" alt="{{ theme.title }}"
                             loading="lazy"
                             style="height: 15px">
                        <span style="font-size: 15px"><strong>{{ theme.title }}</strong></span>
                    </div>
                {% endfor %}
            </div>

            <div class="px-3 pt-1 pb-2">
                <div class="d-flex justify-content-between align-items-start">
                    <h5 class="mb-0" style="font-size: 1rem;">{{ activity.title }}</h5>
                    <span class="text-muted ms-2 flex-shrink-0 d-flex align-items-center gap-1"
                          style="font-size: 0.85rem; white-space: nowrap;">
                                {{ activity.participations|length }} / {{ activity.spot }}
                                <i class="bi bi-people-fill" style="color: var(--quaternary-color)"></i>
                    </span>
                </div>

                <div class="d-flex justify-content-between mt-1">
                    <small class="text-muted">{{ activity.location }}</small>
                    <small
                        class="text-muted">{{ activity.dateStart ? activity.dateStart|date('M d') : '' }}</small>
                </div>

                {% if activity.tags %}
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        {% for tag in activity.tags %}
                            <span class="badge px-2 cactus-tags">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>
    </a>
</div>
