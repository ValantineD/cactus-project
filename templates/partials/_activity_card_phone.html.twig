<a href="{{ path('app_activity_show', {id: activity.id}) }}"
   class="text-decoration-none text-dark"
   style="width: 220px; flex-shrink: 0; border-radius: 10px;
                              overflow: hidden; background: white;
                              box-shadow: 0 1px 6px rgba(0,0,0,0.12);">
        {% if activity.imageFiles is not empty %}
    <div style="height: 120px; overflow: hidden; background: #e9e9e9; position: relative;">
        {% set splitFilename = asset(activity.imageFiles[0].filename)|split('.') %}
        {% set imagefilename = splitFilename|join('_medium.') %}
            <img src="{{ imagefilename }}"
                 alt="{{ activity.title }}"
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy">
        {% else %}
            <div
                class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25">
                <i class="bi bi-image text-muted" style="font-size: 1.5rem;"></i>
            </div>
        {% endif %}
        {% if app.user %}
            {% if app.user == activity.user %}
                <span class="position-absolute top-0 end-0 m-2 badge tag-creator">
                          Créateur
                </span>
            {% else %}
                {% set isParticipating = false %}
                {% for p in activity.participations %}
                    {% if p.user == app.user %}
                        {% set isParticipating = true %}
                    {% endif %}
                {% endfor %}
                {% if isParticipating %}
                    <span class="position-absolute top-0 end-0 m-2 badge d-flex align-items-center gap-1 tag-participation">
                            <i class="bi bi-check-circle-fill"></i>
                            Participation
                    </span>
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
    <div class="px-2 pt-1 pb-2">
        <div class="d-flex align-items-center gap-1 mb-1">
            {% for theme in activity.themes %}
                <div
                    class="d-flex badges-theme align-items-center justify-content-center gap-1 p-1 {{ (activity.themes|length  > 1) ? "w-50" : "w-100" }}">
                    <img src="{{ asset(theme.iconFilename) }}" alt="{{ theme.title }}"
                         loading="lazy"
                         style="height: 15px">
                    <span style="font-size: 12px"><strong>{{ theme.title }}</strong></span>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-between">
            <p class="mb-0 fw-bold" style="font-size: 0.85rem; line-height: 1.2;">{{ activity.title }}</p>
            <small class="text-muted d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                {{ activity.participations|length }} / {{ activity.spot }}
                <i class="bi bi-people-fill" style="color: var(--quaternary-color)"></i>
            </small>
        </div>


        <div class="d-flex justify-content-between mt-1">
            <small class="text-muted" style="font-size: 0.75rem;">{{ activity.location }}</small>
            <small class="text-muted" style="font-size: 0.75rem;">
                {{ activity.dateStart ? activity.dateStart|date('M d') : '' }}
            </small>
        </div>
    </div>
</a>
