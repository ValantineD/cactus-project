{% extends 'base.html.twig' %}

{% block title %}Recherche Activité{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('handle-map') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('handle-map') }}
{% endblock %}

{% block body %}

    {% set activitiesData = [] %}
    {% for activity in activities %}
        {% if activity.latitude and activity.longitude %}
            {% set activitiesData = activitiesData|merge([{
                lat: activity.latitude,
                lng: activity.longitude,
                icon: asset(activity.themes|first.iconFilename),
                title: activity.title
            }]) %}
        {% endif %}
    {% endfor %}

    <div class="d-none d-lg-block container-fluid px-4 py-3" style="align-items: flex-start; gap: 1rem;">
        <div class="row g-3">
            <div class="col-12 col-lg-6 order-lg-1 order-2">
                <div class="row g-3">
                    {% for activity in activities %}
                        <div class="col-12 col-sm-6">
                            {% include('partials/_activity_card_pc.html.twig') %}
                        </div>
                    {% else %}
                        <div class="col-12">
                            <p class="text-muted">Aucune activité trouvée.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-12 col-lg-6 order-lg-2 order-1 container-map">
                <div class="cactus-map cactus-map-desktop" data-activities="{{ activitiesData|json_encode }}"
                     data-localisation="{{ localisation ?? '' }}">
                    {% for activity in activities %}
                        {% if activity.latitude and activity.longitude %}
                            <div class="map-popup-card"
                                 data-lat="{{ activity.latitude }}"
                                 data-lng="{{ activity.longitude }}"
                                 style="display:none; position:absolute; bottom:16px; left:50%;
                        transform:translateX(-50%); z-index:1000; width:calc(100% - 32px);
                        max-width:420px; background: var(--texte-clair); border-radius: 8px">
                                {% include 'partials/_activity_card_phone.html.twig' %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>

    <div class="d-block d-lg-none "
         style="display: flex; flex-direction: column;">

        <div style="height: 60vh; background: #e0e0e0; position: relative;">
            <div class="cactus-map cactus-map-mobile d-flex align-items-center justify-content-center w-100 h-100"
                 data-activities="{{ activitiesData|json_encode }}" data-localisation="{{ localisation ?? '' }}">
                {% for activity in activities %}
                    {% if activity.latitude and activity.longitude %}
                        <div class="map-popup-card"
                             data-lat="{{ activity.latitude }}"
                             data-lng="{{ activity.longitude }}"
                             style="display:none; position:absolute; bottom:16px; left:50%;
                        transform:translateX(-50%); z-index:1000; width:calc(100% - 32px);
                        max-width:420px; background: var(--texte-clair); border-radius: 8px">
                            {% include 'partials/_activity_card_phone.html.twig' %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div style="flex-shrink: 0; padding: 12px 0 12px 12px; background: white;
                    box-shadow: 0 -2px 12px rgba(0,0,0,0.10); overflow-x: auto;
                    scrollbar-width: none; -ms-overflow-style: none;">

            <div style="display: flex; gap: 12px; width: max-content;">
                {% for activity in activities %}
                    {% include('partials/_activity_card_phone.html.twig') %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}







